ADMIN_USERNAME=ngaph082
# Generate using npm run setup. Never enter the plain password here.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Fixed configuration spreadsheet; share Editor access with the service account.
CONFIG_SPREADSHEET_ID=
# Upstash Redis is required in production for distributed login limiting and write locks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional local/public demo only. Never enables admin writes.
DEMO_MODE=false
